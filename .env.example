# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the HTTP server binds to. Render injects its own PORT, so leave this
# unset (or set to 3000) when deploying there.
PORT=3000

# "development" | "production" | "test"
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB connection string. Use a local instance for development and a
# MongoDB Atlas SRV string in deployed environments.
#   local:  mongodb://localhost:30000/nest
#   atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nest
MONGO_URI=mongodb://localhost:30000/nest

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Use long, random, unique strings. The access and refresh secrets MUST differ,
# otherwise a refresh token would also be accepted as an access token.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Token lifetimes. Supports any `ms` string (e.g. 15m, 12h) or a seconds count.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# The single frontend origin allowed to send credentialed requests. Supports a
# comma-separated list, e.g. http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth cookies
# ---------------------------------------------------------------------------
# "lax" (default) | "strict" | "none"
#
# The frontend and the API must share a site for SameSite=Lax cookies to be
# sent. A Vercel frontend (your-app.vercel.app) talking to a Render API
# (your-api.onrender.com) IS cross-site, so set this to "none" there — "none"
# automatically forces the Secure flag.
#
# For a same-site deployment (e.g. both behind one domain) leave it as "lax".
COOKIE_SAME_SITE=lax

# Set to "true" to mark cookies Secure. Implied by NODE_ENV=production and by
# COOKIE_SAME_SITE=none. Leave "false" for plain-HTTP local development.
COOKIE_SECURE=false
